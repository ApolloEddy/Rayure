  "rootMotion": {
    "rootPositionChannel": "Hips — 直接写 root_positions（世界系米制）",
    "rootRotationChannel": "Hips — 写 local_rot_mats[:, 0]（根 global rotation，因父为世界）",
    "note": "转换器不做 root 平滑/修正/去滑步；原样写入"
  },
  "endSites": {
    "strategy": "7 个叶关节保持 JOINT（带 3 旋转通道），各加一个 End Site 子节点",
    "leafJoints": ["Head", "RightHandEnd", "LeftHandEnd", "RightHandThumb1", "LeftHandThumb1", "RightToeBase", "LeftToeBase"],
