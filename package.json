{
  "name": "rayure",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @rayure/wallpaper build",
    "dev": "pnpm -r --parallel dev",
    "dev:companion": "pnpm --filter @rayure/companion dev",
    "dev:wallpaper": "pnpm --filter @rayure/wallpaper dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify.ps1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright-core": "^1.62.1",
    "typescript": "7.0.2"
  }
}
